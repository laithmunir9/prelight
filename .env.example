# Copy to .env and fill in. Never commit .env to GitHub.
PORT=3848

# OpenAI powers optional delivery feedback in Studio. Audio is processed locally.
OPENAI_API_KEY=your-openai-key-here

# Supabase persistence for the deployed server. Keep the secret key server-side.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SECRET_KEY=your-supabase-secret-key
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: defaults to gpt-4.1-mini for role-play replies and feedback.
# OPENAI_CHAT_MODEL=gpt-4.1-mini
# Optional: defaults to gpt-4o-transcribe for stronger speech recognition.
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# Optional: defaults to gpt-4o-mini-tts for agent voice playback.
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Optional: set only if your OpenAI account requires a regional endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Public launch guardrails. Leave PRELIGHT_INVITE_CODE blank for open signup.
# PRELIGHT_INVITE_CODE=your-private-code
AUDIO_MAX_SECONDS=45
AUDIO_MAX_BYTES=6291456
DAILY_SCENARIO_INFERENCE_LIMIT=20
DAILY_MESSAGE_LIMIT=60
DAILY_TRANSCRIPT_POLISH_LIMIT=80
DAILY_TRANSCRIPTION_LIMIT=12
DAILY_SESSION_REVIEW_LIMIT=12
DAILY_TTS_LIMIT=40
IP_AUDIO_HOURLY_LIMIT=20
IP_TTS_HOURLY_LIMIT=80
IP_MESSAGE_HOURLY_LIMIT=120

# Studio launch: disable retired paid chat/audio endpoints.
LEGACY_PRACTICE_ENABLED=false
# Feedback requires both OpenAI and Supabase. Set false to disable it.
STUDIO_FEEDBACK_ENABLED=true
